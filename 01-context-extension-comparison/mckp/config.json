{
  "partitioner": "structural",
  "max_partition_tokens": 400,
  "weights": {"w_r": 0.6, "w_d": 0.2, "w_p": 0.2},
  "positional_shape": "central",
  "mu": 0.1,
  "distance": "compressor_family",
  "selection_mode": "mckp",
  "option_set": [
    {"compressor": "identity", "param": 1.0},
    {"compressor": "cpc_minilm", "param": 0.7},
    {"compressor": "cpc_minilm", "param": 0.5},
    {"compressor": "cpc_minilm", "param": 0.3},
    {"compressor": "llmlingua2", "param": 0.7},
    {"compressor": "llmlingua2", "param": 0.5},
    {"compressor": "llmlingua2", "param": 0.3},
    {"compressor": "omission", "param": 0.0}
  ],
  "required_compressors": ["cpc_minilm", "llmlingua2"],
  "number_retention_threshold": 0.9,
  "budget_tokens": 4000,
  "output_tokens": 500,
